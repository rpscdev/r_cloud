
# App Runtime

APP_ENV=development
LOG_LEVEL=INFO
ENABLE_HSTS=false
CORS_ORIGINS=http://localhost:5173
API_PREFIX=/api/ai/internal


# AI Secrets (required)

GROQ_API_KEY=replace_with_groq_api_key # <- REPLACE THIS (get free key at console.groq.com)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=90
GROQ_MAX_OUTPUT_TOKENS=4096
STRATEGY_CONTEXT_CHAR_LIMIT=24000
TAVILY_API_KEY=replace_with_tavily_api_key # <- REPLACE THIS
APP_ACCESS_PASSWORD=replace_with_strong_internal_password # <- REPLACE THIS


# EU Market Strategy AI (RAG + Crawler + PDF)

CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=eu_market_regulations
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE_WORDS=500
CHUNK_OVERLAP_WORDS=80
REGULATION_DOWNLOAD_DIR=data/regulations
LOCAL_REGULATION_PDFS_DIR=data/regulation_pdfs
MAX_PDF_SIZE_MB=20
REPORT_OUTPUT_DIR=data/reports
ALLOWED_REGULATION_DOMAINS=eur-lex.europa.eu,ec.europa.eu,bundesregierung.de
TAVILY_MAX_RESULTS=8
TAVILY_TIMEOUT_SECONDS=30


# Observability / UI

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password # <- REPLACE THIS

# Git-based Markdown Blog
BLOG_CONTENT_DIR=content/blog
BLOG_IMAGES_DIR=content/images
