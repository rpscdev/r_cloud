# VITE_ variables are baked into the JS bundle at build time — not read at runtime.

# Relative URL — nginx proxies /api/ai/internal/* to the backend container.
VITE_STRATEGY_API_BASE_URL=/api/ai/internal

# Must match APP_ACCESS_PASSWORD in backend/.env.
# WARNING: this value is visible in the compiled JS bundle.
VITE_APP_ACCESS_PASSWORD=your_app_password_here
