# Internal FastAPI strategy route base URL.
# Local dev example: http://localhost:8000/api/ai/internal
# Docker + Nginx example: /api/ai/internal
VITE_STRATEGY_API_BASE_URL=http://localhost:8000/api/ai/internal

# Optional for local testing when backend route protection is enabled.
# WARNING: VITE_ variables are exposed in browser bundles.
VITE_APP_ACCESS_PASSWORD=change_me_internal_password
